<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#0F766E</item>
        <item name="android:colorPrimaryDark">#0F766E</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:windowBackground">#F2F5F8</item>
        <item name="android:statusBarColor">#F2F5F8</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
